<Window x:Class="RPGCharacterManager.Views.StatEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Character Stats" Height="550" Width="400" 
        Background="{StaticResource PixelBg}" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Sprite -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Border BorderBrush="White" BorderThickness="3" Width="80" Height="80" Background="#000000">
                <Image Source="{Binding Character.SpritePath}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Character Editor" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PixelAccent}" FontFamily="Consolas"/>
                <TextBlock Text="{Binding Character.Name}" Foreground="White" FontSize="14" FontFamily="Consolas"/>
            </StackPanel>
        </StackPanel>

        <!-- Stats and Inventory -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Name:" Foreground="White" FontFamily="Consolas"/>
                <TextBox Text="{Binding Character.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <Label Content="Class:" Foreground="White" FontFamily="Consolas"/>
                <TextBox Text="{Binding Character.Class, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <GroupBox Header="Equipment (6 Slots )" Margin="0,10,0,0" Foreground="White" BorderBrush="White" FontFamily="Consolas">
                    <ItemsControl ItemsSource="{Binding Character.Equipment}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemSlot}" MouseLeftButtonDown="Slot_Click" Cursor="Hand">
                                    <Grid>
                                        <!-- Placeholder -->
                                        <Image Source="pack://application:,,,/Assets/Items/empty_slot.png" Opacity="0.2" 
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- Item Icon -->
                                        <Image Source="{Binding IconPath}" 
                       ToolTip="{Binding Name}" 
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- Item Stat -->
                                        <TextBlock Text="{Binding Strength}" 
                                           FontSize="12" Foreground="White" 
                                           Background="#AA000000" 
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                           Padding="2" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding Intelligence}" 
                                           FontSize="12" Foreground="White" 
                                           Background="#AA000000" 
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                           Padding="2" FontFamily="Consolas"/>             


                                        <!-- Remove Button -->
                                        <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Width="18" Height="18" FontSize="10" Padding="0" Background="#AA0000"
                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,15,0,0">
            <Button Content="Save" Click="Save_Click" Margin="5"/>
            <Button Content="Cancel" IsCancel="True" Margin="5"/>
        </UniformGrid>
    </Grid>
</Window>
