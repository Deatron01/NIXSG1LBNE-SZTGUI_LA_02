<Window x:Class="RPGCharacterManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RPGCharacterManager.ViewModels"
        Title="RPG Character Manager" Height="500" Width="800" 
        Background="#1A1A1A" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Character List -->
            <DataGrid ItemsSource="{Binding Characters}" 
                      SelectedItem="{Binding SelectedCharacter}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="#2D2D2D" 
                      Foreground="Black"
                      RowBackground="Gray"
                      AlternatingRowBackground="LightGoldenrodYellow"
                      BorderBrush="Black">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Hero" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding SpritePath}" Width="48" Height="48" 
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="*"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="*"/>
                    <DataGridTextColumn Header="Strength" Binding="{Binding TotalStrength}" Width="*"/>
                    <DataGridTextColumn Header="Intelligence" Binding="{Binding TotalIntelligence}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Preview Panel -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Selected Hero" Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <Border BorderBrush="White" BorderThickness="4" Width="160" Height="160" Background="#000000">
                    <Image Source="{Binding SelectedCharacter.SpritePath}" 
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock Text="{Binding SelectedCharacter.Name}" 
                           Foreground="White" 
                           HorizontalAlignment="Center" FontSize="20" Margin="0,10,0,0" FontFamily="Consolas"/>
                <TextBlock Text="{Binding SelectedCharacter.Class}" 
                           Foreground="LightGray" 
                           HorizontalAlignment="Center" FontSize="14" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Add New" Command="{Binding AddCommand}" Width="120" Height="35" Margin="5"/>
            <Button Content="Edit Selected" Command="{Binding EditCommand}" Width="120" Height="35" Margin="5"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Width="120" Height="35" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
