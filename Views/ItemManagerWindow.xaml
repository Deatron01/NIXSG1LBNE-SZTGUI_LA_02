<Window x:Class="RPGCharacterManager.Views.ItemManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Database" Height="450" Width="550"
        Background="{StaticResource PixelBg}" WindowStartupLocation="CenterOwner">
	<Grid Margin="15">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>

		<!-- Item List -->
		<GroupBox Header="Global Items" Foreground="White" BorderBrush="White" FontFamily="Consolas">
			<ListBox ItemsSource="{Binding AllItems}" SelectedItem="{Binding SelectedItem}"
                     Background="#1A1A1A" BorderThickness="0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" Margin="5">
							<Border BorderBrush="White" BorderThickness="2" Background="#000000" Margin="0,0,10,0">
								<Image Source="{Binding IconPath}" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontFamily="Consolas"/>
								<TextBlock Text="{Binding Strength, StringFormat='Strength: {0}'}" Foreground="{StaticResource PixelAccent}" FontSize="10" FontFamily="Consolas"/>
								<TextBlock Text="{Binding Intelligence, StringFormat='Intelligence: {0}'}" Foreground="{StaticResource PixelAccent}" FontSize="10" FontFamily="Consolas"/>
							</StackPanel>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</GroupBox>

		<!-- Editor Panel -->
		<StackPanel Grid.Column="1" Margin="15,0,0,0">
			<TextBlock Text="Item Details" Foreground="{StaticResource PixelAccent}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" FontFamily="Consolas"/>

			<Label Content="Name:" Foreground="White" FontFamily="Consolas"/>
			<TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

			<Label Content="Strength:" Foreground="White" FontFamily="Consolas"/>
			<TextBox Text="{Binding SelectedItem.Strength, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

			<Label Content="Intelligence:" Foreground="White" FontFamily="Consolas"/>
			<TextBox Text="{Binding SelectedItem.Intelligence, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

			<Button Content="Add New" Command="{Binding AddCommand}" Margin="0,10,0,5"/>
			<Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,0,10"/>

			<Border BorderThickness="2" BorderBrush="{StaticResource PixelAccent}" Padding="2" Margin="0,10,0,0">
				<Button Content="Select Item" Click="Select_Click" Background="{StaticResource PixelAccent}" Foreground="Black"/>
			</Border>
		</StackPanel>
	</Grid>
</Window>
